#                                                     temperature=0.5 \
#                                                     run_name=penicillin_vanilla_pg_fragmented_T0.5 \
#                                                     output_dir=/home/jgershon/projects/itopt/policy_mpnn/penicillin_vanilla_pg_fragmented_T0.5