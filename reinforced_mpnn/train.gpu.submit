#!/bin/bash
#SBATCH -p gpu-train
#SBATCH --gres=gpu:l40:8
#SBATCH --nodes=1
#SBATCH -c 8
#SBATCH -J itopt
#SBATCH --mem=64g
#SBATCH --ntasks=1
#SBATCH --time=2-00:00:00
#SBATCH -o logs/logs_%j.out
#SBATCH --exclude g2521,g2536,g2541


### change 5-digit MASTER_PORT as you wish, slurm will raise Error if duplicated with others
### change WORLD_SIZE as gpus/node * num_nodes
export MASTER_PORT=36799

### get the first node name as master address - customized for vgg slurm
### e.g. master(gnodee[2-5],gnoded1) == gnodee2
export MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n 1)

export PYTHONPATH=$PYTHONPATH:/home/jgershon/git/cleo/reinforced_mpnn/:/home/jgershon/git/cleo/
export HYDRA_FULL_ERROR=1


source activate newlatent; python train_policy.py -cn petase_dapo
